{
  "_note": "Usage assumptions behind docs/BILLING_COST_MODEL.md. Every number here is an input you can change; rerun the notebook to see the effect. Confidence: 'weak' means an educated guess a semester of pilot data should replace.",

  "lecture": {
    "durationMinutes": 75,
    "phrasesPerMinute": 9,
    "inputTokensPerCall": 3000,
    "outputTokensPerCall": 350,
