    "pro": {
      "lecturesPerMonth": 26,
      "sections": 3,
      "priceUsd": 99,
      "cloudCapture": true
    },
    "max": {
      "lecturesPerMonth": 40,
      "sections": 4,
      "priceUsd": 299,
      "cloudCapture": true
    }
  },

  "targets": {
    "worstCaseShareOfPrice": 0.6,
    "lightUtilisation": 0.25,
    "expectedUtilisation": 0.5,
    "heavyUtilisation": 0.8,
