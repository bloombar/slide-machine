    "_confidence": "weak throughout"
  },

  "audience": {
    "studentsPerSection": 30,
    "deckOpenRate": 0.5,
    "playbacksPerViewingStudent": 1.3,
    "localesPerDeck": 0.5,
    "imageMbPerPlayback": 9.0,
    "narrationAudioMbPerPlayback": 5.4,
    "_confidence": "weak throughout: these drive the entire student-cost picture"
  },

  "storage": {
    "retainedAudioHeldDaysFactor": 1.0,
    "_note": "Audio MB per lecture is derived from the capture rate; held volume comes from each tier's audioRetentionDays in config/plans.json."
  },

  "tiers": {
    "free": {
      "lecturesPerMonth": 4,
