    "slideTextChars": 400,
    "narrationCharsPerSlide": 600,
    "captureSampleRateHz": 24000,
    "captureBytesPerSample": 2,
    "sttMinutesPerLectureMinute": 1.0,
    "_confidence": {
      "durationMinutes": "product decision",
      "inputTokensPerCall": "weak: +/-30%, an independent estimate said 2200",
      "outputTokensPerCall": "weak",
      "slideTextChars": "weak: unmeasured",
      "narrationCharsPerSlide": "weak: unmeasured"
    }
  },

  "perLectureExtras": {
    "rerankInputTokensPerSlide": 1500,
    "rerankOutputTokensPerSlide": 200,
    "quizInputTokens": 12000,
    "quizOutputTokens": 2000,
    "embeddingTokens": 23000
  },

  "revision": {
    "_note": "The 'light' profile: what an average teacher does after a lecture, not a power user.",
    "refinedSlideShare": 0.25,
    "refineInputTokensPerSlide": 2500,
    "refineOutputTokensPerSlide": 500,
    "narrateInputTokensPerSlide": 2000,
    "narrateOutputTokensPerSlide": 400,
