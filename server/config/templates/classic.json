{
  "id": "classic",
  "name": "Classic",
  "theme": {
    "background": "#fefce8",
    "surface": "#ffffff",
    "text": "#1c1917",
    "muted": "#78716c",
    "accent": "#b45309",
    "penColor": "#1c1917",
    "highlighterColor": "#fbbf24"
  },
  "layouts": [
    {
      "type": "title",
      "label": "Title",
      "purpose": "Opening slide: the lecture or major-topic title, nothing else",
      "slots": [
        {
          "name": "title",
          "kind": "text",
          "label": "Slide title"
        },
        {
          "name": "caption",
          "kind": "text",
          "label": "Slide caption"
        }
      ],
      "constraints": {
        "maxTitleChars": 50,
        "maxCaptionChars": 80
      },
      "elementPositions": {}
    },
    {
      "type": "section",
      "label": "Section",
      "purpose": "A new section or subtopic heading within the lecture",
      "slots": [
        {
          "name": "title",
          "kind": "text",
          "label": "Slide title"
        }
      ],
      "constraints": {
        "maxTitleChars": 50
      },
      "elementPositions": {}
    },
    {
      "type": "content",
      "label": "Content",
      "purpose": "General slide: a short title plus one paragraph of body text",
      "slots": [
        {
          "name": "title",
          "kind": "text",
          "label": "Slide title"
        },
        {
          "name": "body",
          "kind": "text",
          "label": "Slide body",
          "multiline": true
        }
      ],
      "constraints": {
        "maxBodyChars": 400,
        "maxTitleChars": 50
      },
      "elementPositions": {}
    },
    {
      "type": "list",
      "label": "Bullet list",
      "purpose": "Use for 3-6 short parallel points",
      "slots": [
        {
          "name": "title",
          "kind": "text",
          "label": "Slide title"
        },
        {
          "name": "bullets",
          "kind": "bullets",
          "label": "Slide bullets"
        }
      ],
      "constraints": {
        "maxBullets": 6,
        "maxTitleChars": 50,
        "maxBulletChars": 70
      },
      "elementPositions": {}
    },
    {
      "type": "content-list",
      "label": "Text and points",
      "purpose": "A sentence or two that sets something up, then the points that follow from it",
      "slots": [
        {
          "name": "title",
          "kind": "text",
          "label": "Slide title"
        },
        {
          "name": "body",
          "kind": "text",
          "label": "Opening text",
          "multiline": true
        },
        {
          "name": "bullets",
          "kind": "bullets",
          "label": "Slide bullets"
        }
      ],
      "constraints": {
        "maxTitleChars": 50,
        "maxBodyChars": 200,
        "maxBullets": 4,
        "maxBulletChars": 70
      },
      "elementPositions": {}
    },
    {
      "type": "image-heavy",
      "label": "Image",
      "purpose": "A striking image dominates; minimal caption text",
      "slots": [
        {
          "name": "image",
          "kind": "image",
          "label": "Slide image"
        },
        {
          "name": "caption",
          "kind": "text",
          "label": "Slide caption"
        }
      ],
      "constraints": {
        "imageRequired": true,
        "maxCaptionChars": 80
      },
      "elementPositions": {}
    },
    {
      "type": "two-column",
      "label": "Two column",
      "purpose": "Text beside a supporting image",
      "slots": [
        {
          "name": "title",
          "kind": "text",
          "label": "Slide title"
        },
        {
          "name": "body",
          "kind": "text",
          "label": "Slide body",
          "multiline": true
        },
        {
          "name": "image",
          "kind": "image",
          "label": "Slide image"
        }
      ],
      "constraints": {
        "maxBodyChars": 250,
        "maxTitleChars": 50
      },
      "elementPositions": {}
    },
    {
      "type": "quote",
      "label": "Quote",
      "purpose": "A single striking statement, question, or quotation",
      "slots": [
        {
          "name": "body",
          "kind": "text",
          "label": "Slide body",
          "multiline": true
        },
        {
          "name": "caption",
          "kind": "text",
          "label": "Slide caption"
        }
      ],
      "constraints": {
        "maxBodyChars": 200,
        "maxCaptionChars": 60
      },
      "elementPositions": {}
    },
    {
      "type": "code",
      "label": "Code",
      "purpose": "A program listing under a short title: a worked snippet, a command, a function being walked through",
      "slots": [
        {
          "name": "title",
          "kind": "text",
          "label": "Slide title"
        },
        {
          "name": "snippet",
          "kind": "code",
          "label": "Program listing",
          "description": "The listing itself, exactly as it would be typed. Never a sentence about it."
        }
      ],
      "constraints": {
        "maxTitleChars": 50
      },
      "elementPositions": {}
    },
    {
      "type": "formula",
      "label": "Formula",
      "purpose": "One equation or expression, set large, with a short title and an optional note beneath",
      "slots": [
        {
          "name": "title",
          "kind": "text",
          "label": "Slide title"
        },
        {
          "name": "eq",
          "kind": "math",
          "label": "Equation",
          "description": "The expression in LaTeX, with no surrounding prose."
        },
        {
          "name": "caption",
          "kind": "text",
          "label": "Slide caption"
        }
      ],
      "constraints": {
        "maxTitleChars": 50,
        "maxCaptionChars": 120
      },
      "elementPositions": {}
    },
    {
      "type": "whiteboard",
      "label": "Whiteboard",
      "purpose": "A blank slate for freehand drawing",
      "slots": [],
      "elementPositions": {}
    }
  ]
}
