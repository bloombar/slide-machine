{
  "name": "@slide-machine/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express API for Slide Machine V2 — serves the built SPA in production",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest run src",
    "test:integration": "vitest run test/integration",
    "test:coverage": "vitest run src --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.2.3",
    "mongoose": "^9.7.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "vitest": "^4.1.10"
  }
}
