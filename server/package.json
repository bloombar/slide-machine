{
  "name": "@slide-machine/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Express API for Slide Machine V2 — serves the built SPA in production",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "seed": "tsx src/db/seed.ts",
    "test": "vitest run src",
    "test:integration": "vitest run test/integration",
    "test:coverage": "vitest run src --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/lib-storage": "^3.1098.0",
    "@google-cloud/speech": "^7.5.0",
    "@google-cloud/storage": "^7.21.0",
    "adm-zip": "^0.6.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^10.9.0",
    "google-forms-quiz-tool": "github:bloombar/google-forms-quiz-generator",
    "googleapis": "^173.0.0",
    "highlight.js": "^11.11.1",
    "jose": "^6.2.3",
    "mammoth": "^1.12.0",
    "mathjax-full": "^3.2.1",
    "mongoose": "^9.7.4",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.4",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^4.0.1",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-breaks": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "sharp": "^0.35.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "unpdf": "^1.6.2",
    "ws": "^8.21.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/hast": "^3.0.5",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "vitest": "^4.1.10"
  }
