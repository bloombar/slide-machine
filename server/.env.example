# Slide Machine V2 server configuration (SPEC TECH-4).
# Copy to server/.env and fill in values. Never commit .env.
# Only MONGODB_URI is required to boot the walking skeleton; the rest
# become required as their features land.
#
# CONVENTION — 0 means "no limit", never "off":
#   STT_CAPTURE_SAMPLE_RATE          0 = no downsampling (stream native rate)
#   AUDIO_RETENTION_DAYS             0 = keep recordings forever (no sweep)
#   AUDIO_RETENTION_MAX_SESSION_MB   0 = no per-session buffer cap
#   AUDIO_RETENTION_MAX_TOTAL_MB     0 = no process-wide buffer ceiling
#   DELETED_DATA_RETENTION_DAYS      0 = keep tombstones forever (no purge)
# Setting any of these to 0 REMOVES a bound, so it costs more (audio kept
# longer, more memory, more bandwidth) rather than less. The one exception is
# WHITEBOARD_SUPPRESS_DEBOUNCE_MS, where 0 is a literal zero-length grace
# window and so really does disable the behavior.

# --- Core ---
NODE_ENV=development
PORT=3000
# With authentication, include credentials AND the database the user was
# created in: mongodb://user:pass@localhost:27017/slide-machine?authSource=admin
MONGODB_URI=mongodb://localhost:27017/slide-machine
# Separate database used by integration tests
MONGODB_TEST_URI=mongodb://localhost:27017/slide-machine-test

# --- Paths (defaults fit the repo layout; override in Docker/DO) ---
# CLIENT_DIST=../client/dist
# PLANS_CONFIG_PATH=../config/plans.json

# --- Auth (AUTH-1/2) ---
# REQUIRED, min 32 chars each — generate with: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
# Token lifetimes (seconds); defaults: 15 min access, 30 day refresh
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_SECONDS=2592000
# How long a rotated-out refresh token stays usable (two-tab race window)
# REFRESH_GRACE_SECONDS=60
# Comma-separated account emails granted admin access to the console
# (/app/admin): the user/project/lecture directories plus moderation
# (delete user/project/lecture, ban email, reset password) and the audit
# log. This allowlist is the security boundary for every /api/admin route
# and lets an admin read every user's data — keep it short. Read on every
# request, so changes take effect on restart with no migration. Unset = no
# admins. Full operator guide: docs/ADMINISTRATION.md.
# ADMIN_EMAILS=you@example.com

# --- AI providers: active adapter per capability (GEN-2/TECH-8) ---
# Live-session speech engine (also drives the client via /api/config):
#   browser = keyless Web Speech API (default) | none = typed Speak bar only
#   google-cloud = real-time streaming STT (needs GOOGLE_APPLICATION_CREDENTIALS)
TRANSCRIPTION_PROVIDER=browser
# mock = deterministic local generation; switch to gemini once GEMINI_API_KEY
# exists (the code default is gemini — a fresh .env without this line will
# try the real API and fail without a key)
GENERATION_PROVIDER=mock
QUIZ_PROVIDER=gemini
IMAGE_GEN_PROVIDER=gemini
# How the quiz publishes to Google Forms: 'mock' fabricates a Form URL (dev/
# tests, no Google needed); 'live' runs the real connected-account OAuth +
# Quiz Generator library flow (needs the Forms/Drive scopes and offline access
# configured on the OAuth client — docs/GOOGLE_API_KEYS.md §6, and a set
# CONNECTED_ACCOUNT_TOKEN_ENC_KEY below).
QUIZ_PUBLISH_MODE=live

# --- AI service credentials (how to create: docs/GOOGLE_API_KEYS.md) ---
GEMINI_API_KEY=
# Generation model + hard per-call timeout; the default favors latency
#GEMINI_MODEL=gemini-3.5-flash-lite
#GEMINI_TIMEOUT_MS=12000
# Embedding model (whiteboard-mark re-anchoring, WB-2). Changing it requires
# re-tuning PHRASE_MATCH_THRESHOLD — see server/src/actions/remap-drawings.ts
#GEMINI_EMBED_MODEL=gemini-embedding-001
# AI content freedom 1-5: 1 = slides contain only what was spoken,
# 5 = free elaboration. Projects and lectures can override.
#GENERATION_FREEDOM=2
# Prompt templates live in config/prompts (see docs/GENERATION_PROMPT.md)
#PROMPTS_DIR=../config/prompts
# Starter slide templates, one JSON each (see docs/TEMPLATES.md)
#TEMPLATES_DIR=config/templates
# Debug: log each assembled prompt + raw model response (prompts include
# seed material — dev use only)
#GENERATION_LOG_PROMPTS=false
# Experimental: let the generation model recognize plain speech (no wake
# word) as CAP-4 voice commands (next/previous/pause/new slide)
# GENERATION_VOICE_COMMANDS=false
# GEN-8 layout re-fit: updates may switch a slide's layout as content
# grows (validated server-side). Flip off to pin layouts at creation.
# GENERATION_LAYOUT_REFIT=true
# Live rephrasing: allow a same-layout "refit" that re-states the current
# slide's existing content when clearer phrasing would improve it. On by
# default; flip off to keep committed slide text verbatim mid-lecture.
# Only applies while GENERATION_LAYOUT_REFIT is on.
# GENERATION_LIVE_REPHRASE=true
# Deck-structure context: send the outline of heading (title/section) slides
# plus positional signals and their heading-decision instructions, so the
# windowed model judges title/section slides from the deck's structure. On by
# default; flip off to restore the pre-structure prompt.
# GENERATION_DECK_STRUCTURE=true
# Service-account JSON for real-time Cloud STT streaming (only when
# TRANSCRIPTION_PROVIDER=google-cloud). Streaming needs a service account,
# not an API key — see docs/GOOGLE_API_KEYS.md.
# Local dev: point at a key file (a bare filename resolves against server/).
# GOOGLE_APPLICATION_CREDENTIALS=service-account.json
# Deployed hosts with no key file (e.g. DO App Platform): paste the whole
# key JSON here instead; it takes precedence and is loaded in memory.
# `docker compose up` MUST use this inline form too — the key file is not
# copied into the image (.dockerignore), so the file-path variant above
# resolves to nothing in the container.
# GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_CLOUD_TRANSLATION_KEY=

# --- Translated viewing: slide content in another language (SHARE-2) ---
# Uses the Cloud Translation key above (plain REST API key, like TTS).
# Without a key the feature is disabled and the viewer's slide-language
# switcher is hidden. 'none' disables it explicitly; 'mock' is for tests.
# TRANSLATION_PROVIDER=google-cloud

# --- Text-to-speech: slide/deck playback (plain REST API key, like Translation) ---
# Without a key the feature is disabled: no play button, no "Speak this slide".
# 'none' disables it explicitly; 'mock' is for tests. See docs/GOOGLE_API_KEYS.md.
TTS_PROVIDER=google-cloud
GOOGLE_CLOUD_TTS_KEY=
TTS_LANGUAGE=en-US
# Default narration voice id from the catalog (emma/sophie/james/daniel/aria/
# nova/leo/owen). Blank → the provider's own default voice for the language.
TTS_DEFAULT_VOICE=nova

# --- OAuth: sign-in (AUTH-1) and connected accounts (EXP-4) ---
# Google sign-in: create these in the Cloud Console (docs/GOOGLE_SIGN_IN.md).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Public origin the app is served from, used to build the OAuth redirect URI
# and the post-login landing. One origin serves both the SPA and the API: in
# local dev set http://localhost:5173 (the Vite dev server, which proxies /api
# to Express); in production set the real domain. Absent derives from the
# request. The matching /api/auth/google/callback must be registered in Google.
PUBLIC_BASE_URL=
# Optional. Origin the browser reaches the SPA at, used only for the sign-in
# landing. In `npm run dev` the app runs on Vite (5173) while the OAuth callback
# stays on PUBLIC_BASE_URL (3000), so set this to http://localhost:5173 to land
# sign-in on the running app. Leave unset in production (one origin serves both).
CLIENT_APP_URL=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Encrypts stored connected-account tokens at rest (P-9)
CONNECTED_ACCOUNT_TOKEN_ENC_KEY=

# --- Exporting a lecture (EXP-1/EXP-4) ---
# EXP-1's second export shape: the lecture carries its style template as the
# presentation's own layout pages, so the file can be restyled where it lands
# and re-imported with that design intact. Off by default — a flat file is
# what most people want to hand someone. On, the choice appears beside the
# format; off, the option is absent and the server ignores the field.
# EXPORT_REUSABLE_LAYOUTS=false

# --- Billing (TECH-9); tier prices/caps live in config/plans.json (BILL-6) ---
# Active billing adapter: 'stripe' (needs the keys below) or 'mock'
# (in-memory, no network — dev and e2e). Full Stripe setup: docs/STRIPE.md
# 'mock' accepts webhooks unsigned, so the server refuses to boot with it
# when NODE_ENV=production (P-8).
BILLING_PROVIDER=stripe
# Escape hatch for a test harness that runs the production build against mock
# billing (the e2e suite does). Never set this on a real deployment: it is the
# only way to serve an unsigned webhook endpoint under NODE_ENV=production.
# ALLOW_UNSIGNED_BILLING_WEBHOOKS=false
STRIPE_SECRET_KEY=
# Signs webhook deliveries. Point the provider's endpoint at
# <PUBLIC_BASE_URL>/api/billing/webhook and subscribe it to the
# customer.subscription.* events — a plan only changes when one arrives.
STRIPE_WEBHOOK_SECRET=

# --- Image enrichment (IMG-1; Wikimedia and Openverse are keyless) ---
# Background stock-image fetch for slides; Flickr joins the pool if a key
# is set (how to create: docs/IMAGE_ENRICHMENT.md)
IMAGE_ENRICHMENT_ENABLED=true
FLICKR_API_KEY=
# Tuning (all optional — shown values are the code defaults):
# Results fetched per source, and how many keyword phrases are searched.
IMAGE_SOURCE_RESULTS=8
IMAGE_MAX_QUERY_PHRASES=6
# AI re-rank: Gemini picks the best candidate for the slide and matches the
# caption to it (needs GEMINI_API_KEY; falls back to heuristic scoring without).
IMAGE_RERANK_ENABLED=true
IMAGE_RERANK_SHORTLIST=12
# Vision re-rank sends candidate thumbnails to Gemini (more accurate, slower).
IMAGE_RERANK_VISION=false
IMAGE_RERANK_TIMEOUT_MS=6000

# --- Email: feedback form, verification + password reset (AUTH-3/4) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# How outgoing mail leaves: 'smtp' relays through the settings above, 'log'
# writes the message to the server log instead (dev — no relay needed), 'none'
# disables mail. Features that need mail hide themselves when it cannot send.
#MAIL_PROVIDER=smtp
# Envelope sender for mail the app originates; defaults to SMTP_USER.
#MAIL_FROM=
# Where the "Send feedback" page delivers. Unset hides the form.
#FEEDBACK_EMAIL=feedback@example.com
# With MAIL_PROVIDER=log, also append every message to this file. Used by the
# e2e run to read a real verification / reset link; unset everywhere else.
#MAIL_LOG_FILE=

# --- Who runs this deployment (the privacy policy + terms name them) ---
# Published by GET /api/config and printed verbatim on /privacy and /terms,
# so a change of entity or address needs a restart, not a release. Nothing
# here is secret. Each one left blank shows a bracketed placeholder on the
# page, which reads as the draft it is — fill all four in before launch.
OPERATOR_NAME=
OPERATOR_JURISDICTION=
OPERATOR_CONTACT_EMAIL=
OPERATOR_POSTAL_ADDRESS=

# --- Uploaded-file storage (SEED-1) ---
# 'local' writes to disk (dev/test default); 's3' targets the bucket below
#STORAGE_PROVIDER=local
#STORAGE_LOCAL_DIR=.uploads

# --- Live speech capture (CAP-3) ---
# Rate (Hz) the browser downsamples mic audio to before streaming, published to
# the client via /api/config. The browser's native 48 kHz costs bandwidth,
# retention memory, and stored size for content the speech models discard —
# Google's are trained at 16 kHz.
#
# The 24 kHz default splits the difference. Transcription only needs 16, but the
# same recording is played back per slide, and 16 kHz reproduces nothing above
# 8 kHz — where the sibilance of "s" and "f" lives — so speech stays perfectly
# intelligible but sounds dull. 24 kHz keeps that for half the cost of 48 kHz.
# Set 16000 if playback fidelity does not matter to you.
#
# Raising this also SHORTENS how long a session runs before
# AUDIO_RETENTION_MAX_SESSION_MB truncates it, so set the two together.
# A client whose AudioContext already runs at or below this streams its native
# rate (we never upsample). Range 8000–48000, or 0 to turn downsampling OFF
# entirely. Note 0 here means "no limit" (the most audio, not the least),
# matching the retention ceilings below; a value between 1 and 7999 is rejected
# at boot rather than silently accepted.
#STT_CAPTURE_SAMPLE_RATE=24000

# --- Lecture-audio retention (GEN-4 Phase 2) ---
# Off by default. When true AND TRANSCRIPTION_PROVIDER=google-cloud, each live
# session's audio is STREAMED to the storage above as it arrives (raw LINEAR16
# `.pcm`, for later batch diarization) and referenced on the deck. Adds
# ~2.9 MB/min at the default 24 kHz capture rate (~1.9 at 16000, ~5.8 at
# 48000). The browser STT engine is
# unaffected (its audio never reaches the server).
#AUDIO_RETENTION_ENABLED=false
# A daily sweep deletes expired recordings — the audio and its deck reference —
# for cost + student-voice privacy. This is the deployment-wide ceiling; each
# plan tier sets its own audioRetentionDays in config/plans.json and the SHORTER
# of the two wins, so this can tighten a tier's window but never loosen it.
# 0 = sweep off, keep forever (tiers included).
#AUDIO_RETENTION_DAYS=30
# Ceiling (MB) on how much audio ONE session may STORE. Because audio streams
# out as it arrives, a long lecture no longer costs memory — this is a
# storage-cost limit, not a memory guard. At 24 kHz, 300 MB is ~1 h 49 min
# (~55 min at 48000). Past it that session keeps transcribing but stops
# retaining, so the recording is silently truncated — raise it if you expect
# longer single sittings. 0 = no per-session cap.
#AUDIO_RETENTION_MAX_SESSION_MB=300
# Ceiling (MB) on the memory live retention may hold across ALL concurrent
# sessions. A recording no longer costs memory proportional to its length; each
# one holds a fixed in-flight upload window (~11 MB), so this effectively caps
# HOW MANY lectures may record at once — roughly this value / 11. Audio buffers
# sit outside the V8 heap, so an overrun is an OOM kill, not a catchable error.
# Past the ceiling further sessions transcribe WITHOUT retaining audio;
# transcription and slide generation are never affected. 0 = no global limit.
#AUDIO_RETENTION_MAX_TOTAL_MB=128

# --- Soft-delete retention (P-10/P-11) ---
# Deleting any entity (project/deck/slide/template/seed/concept) soft-deletes
# it — tombstoned, hidden from all reads, but recoverable — rather than removing
# it. A daily sweep permanently purges records tombstoned longer ago than this
# many days, cascading to their children and stored blobs. Default 90.
# 0 = keep tombstones forever (purge disabled).
#DELETED_DATA_RETENTION_DAYS=90
# How long raw cost-ledger events (BILL-7) are kept before a complete month is
# rolled up into monthly totals and its rows removed. 0 = keep every event
# forever — fine for a small deployment, unwise for a busy one: this is the one
# collection that grows with usage rather than with content.
#COST_LEDGER_RETENTION_DAYS=365

# --- Post-lecture speaker diarization (GEN-4 Phase 3) ---
# 'none' (default) disables it; 'google-cloud' runs a v2 BatchRecognize job
# (Chirp 3) over the retained audio; 'mock' is for tests. google-cloud needs
# the GCS bucket below (see docs/GOOGLE_API_KEYS.md §3).
#DIARIZATION_PROVIDER=none
# Private GCS bucket the audio is copied into for the batch job — BatchRecognize
# reads gs:// only. Holds raw student-voice audio; keep it non-public.
#GCS_AUDIO_BUCKET=
# Location for the batch recognizer. Chirp 3 is only in the 'us' and 'eu'
# multi-regions (NOT regional endpoints like us-central1). Verified live.
#DIARIZATION_LOCATION=us

# --- Refine slider defaults (GEN-4) ---
# Default strength (1–5) the "Refine all slides" / "Refine the spoken
# transcript" sliders start at when a lecture hasn't set its own. Default 2.
#REFINE_SLIDES_DEFAULT_LEVEL=2
#REFINE_TRANSCRIPT_DEFAULT_LEVEL=2

# --- Debugging ---
# Show the live session's "simulated speech" text box, which feeds typed phrases
# through the same pipeline as spoken ones. Off by default now that real STT
# works; turn it on to drive a lecture without a microphone. Default false.
#SIMULATED_SPEECH_ENABLED=false

# --- Whiteboard (WB-3) ---
# While recording, drawing/erasing suppresses auto-slide-creation. This is how
# long (ms) after the last gesture the suppression lingers, so a pause to switch
# tools or reposition the cursor still counts as active use. Default 5000; 0
# disables the grace window (suppress only during an actual gesture).
#WHITEBOARD_SUPPRESS_DEBOUNCE_MS=5000

# --- S3-compatible object storage: uploads/exports (TECH-10) ---
# Dev: local MinIO (defaults below) — start one with
# `docker compose --profile storage up`. forcePathStyle is required for MinIO.
# Prod: DO Spaces — e.g. S3_ENDPOINT=https://nyc3.digitaloceanspaces.com,
# S3_FORCE_PATH_STYLE=false, S3_PUBLIC_BASE_URL=https://<bucket>.nyc3.cdn.digitaloceanspaces.com
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=slide-machine-dev
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Reads in dev go straight to MinIO; in prod set this to the CDN/Spaces public URL.
S3_PUBLIC_BASE_URL=http://localhost:9000/slide-machine-dev
