# Slide Machine V2 server configuration (SPEC TECH-4).
# Copy to server/.env and fill in values. Never commit .env.
# Only MONGODB_URI is required to boot the walking skeleton; the rest
# become required as their features land.

# --- Core ---
NODE_ENV=development
PORT=3000
# With authentication, include credentials AND the database the user was
# created in: mongodb://user:pass@localhost:27017/slide-machine?authSource=admin
MONGODB_URI=mongodb://localhost:27017/slide-machine
# Separate database used by integration tests
MONGODB_TEST_URI=mongodb://localhost:27017/slide-machine-test

# --- Paths (defaults fit the repo layout; override in Docker/DO) ---
# CLIENT_DIST=../client/dist
# PLANS_CONFIG_PATH=../../config/plans.json

# --- Auth (AUTH-1/2) ---
# REQUIRED, min 32 chars each — generate with: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
# Token lifetimes (seconds); defaults: 15 min access, 30 day refresh
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_SECONDS=2592000
# How long a rotated-out refresh token stays usable (two-tab race window)
# REFRESH_GRACE_SECONDS=60

# --- AI providers: active adapter per capability (GEN-2/TECH-8) ---
# Live-session speech engine (also drives the client via /api/config):
#   browser = keyless Web Speech API (default) | none = typed Speak bar only
#   google-cloud = real-time streaming STT (needs GOOGLE_APPLICATION_CREDENTIALS)
TRANSCRIPTION_PROVIDER=browser
# mock = deterministic local generation; switch to gemini once GEMINI_API_KEY
# exists (the code default is gemini — a fresh .env without this line will
# try the real API and fail without a key)
GENERATION_PROVIDER=mock
QUIZ_PROVIDER=gemini
IMAGE_GEN_PROVIDER=gemini

# --- AI service credentials (how to create: docs/GOOGLE_API_KEYS.md) ---
GEMINI_API_KEY=
# Generation model + hard per-call timeout; the default favors latency
#GEMINI_MODEL=gemini-3.1-flash-lite-preview
#GEMINI_TIMEOUT_MS=12000
# AI content freedom 1-5: 1 = slides contain only what was spoken,
# 5 = free elaboration. Projects and lectures can override.
#GENERATION_FREEDOM=2
# Prompt templates live in config/prompts (see docs/GENERATION_PROMPT.md)
#PROMPTS_DIR=../config/prompts
# Starter slide templates, one JSON each (see docs/TEMPLATES.md)
#TEMPLATES_DIR=config/templates
# Debug: log each assembled prompt + raw model response (prompts include
# seed material — dev use only)
#GENERATION_LOG_PROMPTS=false
# Experimental: let the generation model recognize plain speech (no wake
# word) as CAP-4 voice commands (next/previous/pause/new slide)
# GENERATION_VOICE_COMMANDS=false
# GEN-8 layout re-fit: updates may switch a slide's layout as content
# grows (validated server-side). Flip off to pin layouts at creation.
# GENERATION_LAYOUT_REFIT=true
# Service-account JSON for real-time Cloud STT streaming (only when
# TRANSCRIPTION_PROVIDER=google-cloud). Streaming needs a service account,
# not an API key — see docs/GOOGLE_API_KEYS.md.
# Local dev: point at a key file (a bare filename resolves against server/).
# GOOGLE_APPLICATION_CREDENTIALS=service-account.json
# Deployed hosts with no key file (e.g. DO App Platform): paste the whole
# key JSON here instead; it takes precedence and is loaded in memory.
# `docker compose up` MUST use this inline form too — the key file is not
# copied into the image (.dockerignore), so the file-path variant above
# resolves to nothing in the container.
# GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_CLOUD_TRANSLATION_KEY=

# --- Text-to-speech: slide/deck playback (plain REST API key, like Translation) ---
# Without a key the feature is disabled: no play button, no "Speak this slide".
# 'none' disables it explicitly; 'mock' is for tests. See docs/GOOGLE_API_KEYS.md.
TTS_PROVIDER=google-cloud
GOOGLE_CLOUD_TTS_KEY=
TTS_LANGUAGE=en-US
# Default narration voice id from the catalog (emma/sophie/james/daniel/aria/
# nova/leo/owen). Blank → the provider's own default voice for the language.
TTS_DEFAULT_VOICE=nova

# --- OAuth: sign-in (AUTH-1) and connected accounts (EXP-4) ---
# Google sign-in: create these in the Cloud Console (docs/GOOGLE_SIGN_IN.md).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Public origin the app is served from, used to build the OAuth redirect URI
# and the post-login landing. One origin serves both the SPA and the API: in
# local dev set http://localhost:5173 (the Vite dev server, which proxies /api
# to Express); in production set the real domain. Absent derives from the
# request. The matching /api/auth/google/callback must be registered in Google.
PUBLIC_BASE_URL=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Encrypts stored connected-account tokens at rest (P-9)
CONNECTED_ACCOUNT_TOKEN_ENC_KEY=

# --- Billing (TECH-9); tier prices/caps live in config/plans.json (BILL-6) ---
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Image enrichment (IMG-1; Wikimedia and Openverse are keyless) ---
# Background stock-image fetch for slides; Flickr joins the pool if a key
# is set (how to create: docs/IMAGE_ENRICHMENT.md)
IMAGE_ENRICHMENT_ENABLED=true
FLICKR_API_KEY=
# Tuning (all optional — shown values are the code defaults):
# Results fetched per source, and how many keyword phrases are searched.
IMAGE_SOURCE_RESULTS=8
IMAGE_MAX_QUERY_PHRASES=6
# AI re-rank: Gemini picks the best candidate for the slide and matches the
# caption to it (needs GEMINI_API_KEY; falls back to heuristic scoring without).
IMAGE_RERANK_ENABLED=true
IMAGE_RERANK_SHORTLIST=12
# Vision re-rank sends candidate thumbnails to Gemini (more accurate, slower).
IMAGE_RERANK_VISION=false
IMAGE_RERANK_TIMEOUT_MS=6000

# --- Email: verification + password reset (AUTH-3/4) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Uploaded-file storage (SEED-1) ---
# 'local' writes to disk (dev/test default); 's3' targets the bucket below
#STORAGE_PROVIDER=local
#STORAGE_LOCAL_DIR=.uploads

# --- Lecture-audio retention (GEN-4 Phase 2) ---
# Off by default. When true AND TRANSCRIPTION_PROVIDER=google-cloud, each live
# session's streamed audio is saved as a WAV in the storage above (for later
# batch diarization) and referenced on the deck. Adds ~5.7 MB/min (16 kHz mono),
# more at higher rates. The browser STT engine is unaffected (its audio never
# reaches the server). The GCS copy the batch pass needs lands in Phase 3.
#AUDIO_RETENTION_ENABLED=false
# A daily sweep deletes recordings older than this many days — the WAV and its
# deck reference — for cost + student-voice privacy. 0 = keep forever.
#AUDIO_RETENTION_DAYS=30

# --- Post-lecture speaker diarization (GEN-4 Phase 3) ---
# 'none' (default) disables it; 'google-cloud' runs a v2 BatchRecognize job
# (Chirp 3) over the retained audio; 'mock' is for tests. google-cloud needs
# the GCS bucket below (see docs/GOOGLE_API_KEYS.md §3).
#DIARIZATION_PROVIDER=none
# Private GCS bucket the audio is copied into for the batch job — BatchRecognize
# reads gs:// only. Holds raw student-voice audio; keep it non-public.
#GCS_AUDIO_BUCKET=
# Location for the batch recognizer. Chirp 3 is only in the 'us' and 'eu'
# multi-regions (NOT regional endpoints like us-central1). Verified live.
#DIARIZATION_LOCATION=us

# --- S3-compatible object storage: uploads/exports (TECH-10) ---
# Dev: local MinIO (defaults below) — start one with
# `docker compose --profile storage up`. forcePathStyle is required for MinIO.
# Prod: DO Spaces — e.g. S3_ENDPOINT=https://nyc3.digitaloceanspaces.com,
# S3_FORCE_PATH_STYLE=false, S3_PUBLIC_BASE_URL=https://<bucket>.nyc3.cdn.digitaloceanspaces.com
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=slide-machine-dev
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Reads in dev go straight to MinIO; in prod set this to the CDN/Spaces public URL.
S3_PUBLIC_BASE_URL=http://localhost:9000/slide-machine-dev
