# Slide Machine V2 client configuration (SPEC TECH-5).
# Copy to client/.env.local (never committed). Only VITE_-prefixed vars
# reach the browser — no secrets here.

# API origin. Leave empty for same-origin (dev proxy and production both work).
VITE_API_BASE_URL=

# --- Uncomment as features land ---
# VITE_STRIPE_PUBLISHABLE_KEY=
# VITE_GOOGLE_OAUTH_CLIENT_ID=
# VITE_GITHUB_OAUTH_CLIENT_ID=
