# Slide Machine V2 client configuration (SPEC TECH-5).
# Copy to client/.env.local (never committed). Only VITE_-prefixed vars
# reach the browser — no secrets here.

# API origin. Leave empty for same-origin (dev proxy and production both work).
VITE_API_BASE_URL=

# Max lectures shown per project on the home screen before "Show all"
VITE_HOME_LECTURES_LIMIT=3

# Placeholder name shown for a titleless project (e.g. the default project
# created when a user starts their first lecture without one). OPTIONAL: an
# env var cannot vary by locale, so leaving it blank uses the translated name
# from the locale bundles instead (project.untitled, TECH-12). Set it only to
# override that with one fixed name for this deployment.
VITE_DEFAULT_PROJECT_TITLE=

# The live-session speech engine is chosen by the SERVER (TRANSCRIPTION_PROVIDER
# in server/.env) and reported to the client via /api/config — no client var.

# --- Uncomment as features land ---
# VITE_STRIPE_PUBLISHABLE_KEY=
# VITE_GOOGLE_OAUTH_CLIENT_ID=
# VITE_GITHUB_OAUTH_CLIENT_ID=
