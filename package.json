{
  "name": "slide-machine",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Slide Machine V2 — real-time speech-to-slides for live lectures",
  "workspaces": [
    "shared",
    "server",
    "client",
    "e2e"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"wait-on -t 30000 http-get://localhost:3000/api/health && npm run dev -w client\"",
    "build": "npm run build -w client && npm run build -w server",
    "start": "node server/dist/index.js",
    "test": "npm run test -w shared --if-present && npm run test -w server && npm run test -w client",
    "test:integration": "npm run test:integration -w server",
    "e2e": "npm run test -w e2e",
    "lint": "eslint .",
    "board:derive": "node scripts/board/derive.mjs",
    "board:sync": "node scripts/board/sync.mjs",
    "spaces:lifecycle": "node scripts/spaces/lifecycle.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "wait-on": "^9.0.10"
  }
}
