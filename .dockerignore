# Dependencies — reinstalled inside the image by `npm ci`; host copies are
# built for the wrong platform (darwin) and would clobber the alpine deps.
node_modules/
**/node_modules/

# Build output — the image compiles its own via `npm run build`.
dist/
**/dist/
client/dist/
server/dist/

# Secrets — never bake these into an image layer.
.env
.env.*
!.env.example
*.local
the-slide-machine-6d173e88efd3.json
**/the-slide-machine-6d173e88efd3.json
openai.key

# Test artifacts & coverage.
coverage/
**/coverage/
test-results/
**/test-results/
playwright-report/
blob-report/

# Version control & CI.
.git/
.github/
.gitignore
# ...but keep the minimal git metadata the build needs to stamp the CalVer
# app version (YYYY.MM.DD+<sha>, see server/src/lib/app-version.ts).
!.git/HEAD
!.git/refs
!.git/packed-refs

# Local tooling / editor / OS.
.claude/
.do/
.DS_Store
**/.DS_Store

# Docker's own files (no need in the context).
Dockerfile
.dockerignore
docker-compose.yml

# Local upload storage (STORAGE_PROVIDER=local).
.uploads*/
